# ==============================================================================
# Zoopie Monorepo Environment Configuration Template
# Duplicate this file to .env (or app-specific .env files) for local development.
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# ==============================================================================

# Backend Server Configuration (apps/server)
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zoopie_dev?schema=public

# WebRTC STUN / TURN Configuration
# STUN is used for public IP discovery; TURN is used for symmetric NAT media relay.
# NEVER commit real production TURN shared secrets or credentials.
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_SECRET=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=
TURN_CREDENTIAL_TTL_SECONDS=86400

# Frontend Next.js Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
