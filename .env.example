# ==============================================================================
# Zoopie Monorepo Environment Configuration Template
# Duplicate this file to .env (or app-specific .env files) for local development.
# DO NOT COMMIT SENSITIVE PRODUCTION VALUES TO VERSION CONTROL.
# ==============================================================================

# Backend Server Configuration (apps/server on Render)
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
ALLOW_VERCEL_PREVIEWS=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zoopie_dev?schema=public
DB_TIMEOUT_MS=3000

# Redis State (Optional: for horizontal multi-instance scaling on Render)
REDIS_URL=

# WebRTC STUN / TURN Configuration
# STUN is used for public IP discovery; TURN is used for symmetric NAT media relay.
# NEVER commit real production TURN shared secrets or long-lived credentials.
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_SECRET=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=
TURN_CREDENTIAL_TTL_SECONDS=86400

# Administrator & Moderation Key (DO NOT commit real production key)
ADMIN_SECRET_KEY=zoopie-moderator-secret-key-development-safe-placeholder-123
ADMIN_TOKEN_EXPIRY_SECONDS=28800

# Frontend Next.js Configuration (apps/web on Vercel)
# Public variables exposed to client browser bundles:
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
