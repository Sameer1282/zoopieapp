# ==============================================================================
# Zoopie Monorepo Environment Configuration Template
# Duplicate this file to .env (or app-specific .env files) for local development.
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# ==============================================================================

# Backend Server Configuration (apps/server)
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zoopie_dev?schema=public

# Frontend Next.js Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
